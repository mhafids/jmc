# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================
DATABASE_URL="mysql://root:password@localhost:3306/db_name"

# ==========================================
# 2. APPLICATION IDENTITY
# ==========================================
APP_NAME="NUXT TABLER ADMIN"
APP_CLIENT="Prototipe JMC Admin"
APP_URL="http://localhost:3000"

# ==========================================
# 3. SECURITY & JWT / SESSION CONFIGURATION
# ==========================================
AUTH_SECRET="change-this-to-a-secure-32-char-secret-in-production"
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=180
AUTH_SESSION_WARNING_SECONDS=30
AUTH_REMEMBER_ME_TTL_SECONDS=86400

# ==========================================
# 4. MULTI-FACTOR AUTHENTICATION (OTP) CONFIG
# ==========================================
AUTH_OTP_TTL_SECONDS=180
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_DIGITS=4
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# ==========================================
# 5. CAPTCHA CONFIGURATION
# ==========================================
CAPTCHA_SECRET="change-this-captcha-secret-key-in-production"
CAPTCHA_TTL_SECONDS=300
CAPTCHA_LENGTH=5

# ==========================================
# 6. SMTP / EMAIL SERVICE (OTP DELIVERY)
# ==========================================
MAIL_DRIVER="log"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@perusahaan.co.id"
SMTP_FROM_NAME="Prototipe JMC Admin Security"